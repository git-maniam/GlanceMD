<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GlanceMD_App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar x:Name="DocumentCommands" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Icon="OpenFile" Label="Open" Click="Open_Click" AccessKey="O" />
            <AppBarButton x:Name="ReloadButton" Icon="Refresh" Label="Reload" Click="Reload_Click" IsEnabled="False" />
            <AppBarButton x:Name="PrintButton" Icon="Print" Label="Print" Click="Print_Click" IsEnabled="False" />
            <AppBarButton x:Name="FindButton" Icon="Find" Label="Find" Click="Find_Click" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton Icon="ZoomIn" Label="Zoom in" Click="ZoomIn_Click" />
            <AppBarButton Icon="ZoomOut" Label="Zoom out" Click="ZoomOut_Click" />
            <AppBarButton Icon="View" Label="Outline" Click="Outline_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Reset zoom" Click="ResetZoom_Click" />
                <AppBarButton Label="Use system theme" Tag="Default" Click="Theme_Click" />
                <AppBarButton Label="Light theme" Tag="Light" Click="Theme_Click" />
                <AppBarButton Label="Dark theme" Tag="Dark" Click="Theme_Click" />
                <AppBarButton Label="Clear recent files" Click="ClearRecent_Click" />
                <AppBarButton Label="About GlanceMD" Click="About_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Border x:Name="FindBar" Grid.Row="1" Padding="12,6" BorderThickness="0,1,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="FindTextBox" Width="280" PlaceholderText="Find in document" TextChanged="FindTextBox_TextChanged" />
                <Button Content="Previous" Click="FindPrevious_Click" />
                <Button Content="Next" Click="FindNext_Click" />
                <Button Content="Close" Click="CloseFind_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="OutlinePane" Padding="12" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Outline" Style="{StaticResource SubtitleTextBlockStyle}" Margin="4,4,4,10" />
                    <ListView x:Name="OutlineList" Grid.Row="1" SelectionChanged="OutlineList_SelectionChanged" IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Margin="4,5" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="520">
                    <FontIcon Glyph="&#xE8A5;" FontSize="64" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="GlanceMD" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Open a Markdown file to read formatted text, code, images, and Mermaid diagrams." TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Open Markdown file" HorizontalAlignment="Center" Click="Open_Click" />
                    <TextBlock Text="You can also drop a file here." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="RecentHeading" Text="Recent files" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Visibility="Collapsed" />
                    <ListView x:Name="RecentList" Width="480" MaxHeight="240" ItemClick="RecentList_ItemClick" IsItemClickEnabled="True" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <WebView2 x:Name="DocumentView" Visibility="Collapsed" NavigationStarting="DocumentView_NavigationStarting" />

                <Grid x:Name="LoadingOverlay" Background="#66000000" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <ProgressRing IsActive="True" Width="40" Height="40" />
                        <TextBlock Text="Opening document…" Foreground="White" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Informational" />
    </Grid>
</Page>
